{
  "name": "germanbuddy",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:wordbank": "node scripts/build-wordbank.mjs",
    "validate:wordbank": "node scripts/validate-wordbank.mjs",
    "set:language": "node scripts/set-active-language.mjs",
    "with:language": "node scripts/with-language.mjs",
    "build:store": "node scripts/build-store.mjs",
    "test:app": "node scripts/test-app.mjs",
    "audit:wordbank": "node scripts/audit-wordbank.mjs",
    "pretest": "node scripts/validate-wordbank.mjs",
    "test": "jest --watchAll=false",
    "check:unihan": "node scripts/check-unihan.mjs",
    "check:16kb": "node scripts/check-16kb.js",
    "check:play-version": "node scripts/check-play-version.js"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.3.0",
    "@expo-google-fonts/playfair-display": "^0.3.0",
    "@expo/vector-icons": "^14.0.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "expo": "^53.0.0",
    "expo-asset": "~11.1.7",
    "expo-build-properties": "~0.14.8",
    "expo-constants": "~17.1.8",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-linking": "~7.1.7",
    "expo-notifications": "~0.31.5",
    "expo-router": "~5.1.11",
    "expo-sharing": "~13.1.5",
    "expo-speech": "~13.1.7",
    "expo-splash-screen": "~0.30.10",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "i18n-js": "^4.4.3",
    "query-string": "^7.1.3",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-mmkv": "^3.2.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "babel-jest": "^29.7.0",
    "fflate": "^0.8.2",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.0",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "setupFilesAfterFramework": [],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|react-native-mmkv|i18n-js)"
    ],
    "moduleNameMapper": {
      "^react-native-mmkv$": "<rootDir>/__mocks__/react-native-mmkv.js",
      "^expo-sqlite$": "<rootDir>/__mocks__/expo-sqlite.js",
      "^expo-notifications$": "<rootDir>/__mocks__/expo-notifications.js",
      "^expo-speech$": "<rootDir>/__mocks__/expo-speech.js"
    }
  }
}
