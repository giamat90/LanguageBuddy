  "ruleChecks": {
    "SER_ESTAR": {
      "mustContainAny": [
        "soy",
        "estoy",
        "eres",
        "estás",
        "es",
        "está",
        "somos",
        "estamos",
        "son",
        "están",
        "era",
        "estaba",
        "eran",
        "estaban",
        "fue",
        "estuvo"
      ]
    },
    "POR_PARA": {
      "mustContainAny": [
        "por",
        "para"
      ],
      "exactlyOneOf": [
        "por",
        "para"
      ],
      "forbiddenPhrases": [
        "por favor",
        "por eso",
        "por qué",
        "para qué",
        "por ejemplo"
      ]
    },
    "DIRECT_OBJECT_PRONOUN": {
      "mustContainAny": [
        "lo",
        "la",
        "los",
        "las"
      ]
    }
  },
